# Copie para .env antes de subir os servicos: cp .env.example .env

# ---- Banco de dados ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=challenge
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/challenge?schema=public

# ---- Kafka ----
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=tech-challenge
KAFKA_GROUP_ID_TRANSACTIONS=transactions-consumer
KAFKA_GROUP_ID_ANTI_FRAUD=anti-fraud-consumer

# ---- Portas das aplicacoes ----
TRANSACTIONS_PORT=3001
ANTI_FRAUD_PORT=3002

# ---- Outbox transacional (servico de transacoes) ----
# Intervalo da varredura da tabela de outbox
OUTBOX_POLL_INTERVAL_MS=1000
# Mensagens reivindicadas por varredura
OUTBOX_BATCH_SIZE=50
# Tentativas antes de a mensagem parar de ser reenviada
OUTBOX_MAX_ATTEMPTS=10
# Recuo exponencial entre tentativas: 1s, 2s, 4s... limitado pelo teto
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_MAX_MS=60000
# Tempo que uma mensagem reivindicada fica invisivel para outras instancias do dispatcher
OUTBOX_LEASE_MS=30000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3001
